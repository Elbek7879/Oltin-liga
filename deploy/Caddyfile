# /etc/caddy/Caddyfile — Caddy HTTPS sertifikatini (Let's Encrypt) o'zi oladi va yangilaydi.
# Liga domeni: oltinliga.uz. DNS'da oltinliga.uz va www.oltinliga.uz uchun A yozuvi server IP manziliga yo'naltirilgan bo'lishi kerak.
oltinliga.uz {
	# Yuklanadigan rasm hajmi chegarasi (ilova 3 MB gacha qabul qiladi)
	request_body {
		max_size 4MB
	}

	# Jonli yangilanishlar oqimi (gollar saytda darhol ko'rinishi uchun): siqilmaydi, kutmasdan uzatiladi
	# «header_up -Forwarded»: mijoz yuborgan Forwarded sarlavhasi ilovaga o'tmaydi. Aks holda uni har safar
	# almashtirib, login urinishlari chegarasini aylanib o'tish mumkin (X-Forwarded-For'ni Caddy o'zi qayta yozadi).
	@live path /api/public/live
	handle @live {
		reverse_proxy 127.0.0.1:8080 {
			header_up -Forwarded
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8080 {
			header_up -Forwarded
		}
	}
}

# www bilan yozilsa — asosiy manzilga doimiy yo'naltiriladi: Google saytni bitta manzilda ko'radi, ikki nusxa bo'lmaydi
www.oltinliga.uz {
	redir https://oltinliga.uz{uri} permanent
}
