# Server: /opt/oltin-liga/.env (huquqlar: chmod 600, egasi liga)
# Bu faylni hech kimga yubormang va git'ga qo'shmang.
DB_URL=jdbc:postgresql://localhost:5432/payariq
DB_USERNAME=payariq
DB_PASSWORD=
# Saytning tashqi manzili (oxirida / belgisisiz): Google uchun canonical, sitemap va ulashish havolalari shundan olinadi
SITE_URL=https://sizning-domen.uz
# Rasmlar va jurnallar doimiy papkada saqlanadi
MEDIA_DIR=/opt/oltin-liga/media
LOG_FILE=/opt/oltin-liga/logs/oltin-liga.log
# Birinchi ishga tushirishda bosh tashkilotchi akkaunti shu qiymatlar bilan yaratiladi.
# Kirib, «Hisobim» sahifasida parolni almashtirgach, ADMIN_PASSWORD qatorini o'chirib qo'ying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Tashkilotchi

# Adminlar uchun Telegram bot (@BotFather). Token maxfiy — faqat shu faylda.
TELEGRAM_BOT_TOKEN=
# Bot nomi, @ belgisisiz
TELEGRAM_BOT_USERNAME=
